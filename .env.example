# Aavaran AI backend environment (copy to .env or set in your host's dashboard).
# NEVER commit a real key. The browser never sees it: all Gnani calls go through the API.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
# Optional: force one Timbre voice for every language (default: Shivani; Hinglish uses Poorvi on timbre-v2.5)
# GNANI_TTS_VOICE=Shivani
# Mandi prices for "sell today or store?" — free key from https://data.gov.in (My Account -> API key)
DATA_GOV_IN_API_KEY=
CORS_ORIGINS=*
